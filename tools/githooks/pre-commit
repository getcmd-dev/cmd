#! /bin/bash

# Run a few quick pre-commit hooks to ensure the code is in a good state before committing.

# Fail on errors
set -euo pipefail

# Unset git environment variables that might interfere with git commands
# Git sets GIT_DIR when running hooks, which can cause git rev-parse to return
# incorrect paths when called from subdirectories (especially in worktrees)
unset GIT_DIR
unset GIT_WORK_TREE

repo_root=$(git rev-parse --show-toplevel)
current_dir=$(pwd)

if [ -z "$repo_root" ]; then
    echo "Not a git repository"
    exit 1
fi

# Change to repo root to ensure git commands work correctly
cd "$repo_root"

# Check if there are unstaged changes (excluding untracked files)
has_unstaged_changes=false
if ! git diff-files --quiet; then
    has_unstaged_changes=true
fi

# Stash unstaged changes only if they exist, keeping the index (staged changes) intact
# This allows lint/sync to run on the full working tree
if [ "$has_unstaged_changes" = true ]; then
    git stash push --keep-index --quiet --message "pre-commit-hook-temp"
fi

./cmd.sh lint --diff
./cmd.sh sync:dependencies

# Stage any changes created by lint/sync
git add -u

# Restore unstaged changes only if we stashed them
if [ "$has_unstaged_changes" = true ]; then
    git stash pop --quiet --index 2>/dev/null || {
        echo "⚠️  Warning: Could not restore unstaged changes. Check 'git stash list'"
    }
fi

cd "$current_dir"

echo "✓ Pre-commit hooks completed."
