#! /bin/bash

# Run a few quick pre-push hooks to ensure the code is in a good state before pushing.

# Fail on errors
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
current_dir=$(pwd)

if [ -z "$repo_root" ]; then
    echo "Not a git repository"
    exit 1
fi

# Change to repo root before stashing to ensure git commands work correctly
cd "$repo_root"

# Stash all uncommitted changes (both staged and unstaged)
git stash push --include-untracked --quiet --message "pre-push-stash"
stashed=$?
./cmd.sh lint
./cmd.sh sync:dependencies

# Check if any changes were made
if ! git diff --quiet; then
    echo "Changes detected after running lint and sync. Creating fixup commit..."
    git add -u
    git commit --no-verify -m "fixup: lint and sync dependencies"
    echo "✓ Created fixup commit with lint/sync changes"
else
    echo "✓ No changes needed from lint/sync"
fi

cd "$current_dir"

# Restore the stashed changes if we stashed anything
if [ $stashed -eq 0 ]; then
    git stash pop --quiet 2>/dev/null || {
        echo "⚠️  Warning: Could not restore stashed changes. Check 'git stash list'"
    }
fi

echo "✓ Pre-push hooks completed."
